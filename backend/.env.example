# Local dev with docker-compose (see docker-compose.yml):
DATABASE_URL=postgresql+psycopg://betavision:betavision@localhost:5432/betavision

JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# From Google Cloud Console > APIs & Services > Credentials (OAuth client ID, type "Web application").
GOOGLE_CLIENT_ID=

# Comma-separated list of origins allowed to call this API.
FRONTEND_ORIGINS=http://localhost:3000
